# Cadena de conexión de PostgreSQL (Vercel Postgres, Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd?schema=public"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-por-un-valor-aleatorio-largo"

# URL pública del despliegue (en Vercel se puede omitir, se autodetecta)
NEXTAUTH_URL="http://localhost:3000"
